{
  "name": "superagent-claude-planner",
  "version": "0.1.0",
  "description": "Plans one change across several repositories as coordinated GitHub issues for an issue-driven coding agent.",
  "private": true,
  "type": "module",
  "bin": { "sac-planner": "lib/cli.js" },
  "exports": { ".": "./lib/index.js" },
  "files": ["lib"],
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').chmodSync('lib/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "check": "pnpm typecheck && pnpm format:check && pnpm test && pnpm build"
  },
  "engines": { "node": ">=22.19.0" },
  "packageManager": "pnpm@11.28.11",
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": { "zod": "4.6.7" }
}
